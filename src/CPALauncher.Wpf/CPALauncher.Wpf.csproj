<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>CPA Dock</AssemblyName>
    <RootNamespace>CPALauncher</RootNamespace>
    <Company>DengJie</Company>
    <Product>CPA Dock</Product>
    <Description>CLIProxyAPI 的 Windows 桌面伴侣。</Description>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>0.4.3</Version>
    <FileVersion>0.4.3.0</FileVersion>
    <AssemblyVersion>0.4.3.0</AssemblyVersion>
    <InformationalVersion>0.4.3</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- System tray support -->

    <!-- Modern UI library -->
    <PackageReference Include="HandyControl" Version="3.5.1" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="1.1.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Services\ApplyLauncherUpdate.ps1" LogicalName="CPALauncher.Services.ApplyLauncherUpdate.ps1" />
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\Lucide-LICENSE.txt" />
  </ItemGroup>

</Project>
